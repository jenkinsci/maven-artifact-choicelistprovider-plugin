<?jelly escape-by-default='true'?>
<!--
  Shared "List version numbers only" entry, included by every provider's config.jelly.
  The help text (help-listVersionNumbersOnly.html) lives next to this file and is found
  through the class hierarchy.
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%List version numbers only}" field="listVersionNumbersOnly">
        <f:checkbox default="false" />
    </f:entry>
</j:jelly>
